# Copy this file to ".env" (same folder) and adjust if needed.
# Everything works with the defaults below: no keys or internet services are required.

# --- Security ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_HOURS=24

# --- Database ---
# Default: a local SQLite file (backend/vidyamitra.db), created automatically.
# MySQL example (run: pip install PyMySQL, and create the database first):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/vidyamitra
# PostgreSQL example (run: pip install psycopg2-binary):
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/vidyamitra

# --- Plans ---
FREE_DOC_LIMIT=3
FREE_DAILY_QUESTIONS=20
PRO_PRICE_INR=199
PRO_DAYS=30

# --- Razorpay (optional) ---
# Leave empty to use the built-in demo payment mode.
# For a real checkout, create free TEST keys at https://dashboard.razorpay.com (Settings > API Keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Optional generative answers (any OpenAI-compatible API) ---
# Leave empty to use the built-in offline answer engine.
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o-mini
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=llama3.1   LLM_API_KEY=ollama
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Email OTP (verification and password reset) ---
# Leave SMTP_HOST empty for demo mode: the code is shown on screen and printed in the backend terminal.
# Gmail: use an App Password (not your normal password). See README section 7.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OTP_EXPIRE_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
# If sending fails, show the code on screen so a live demo never gets stuck. Use false in production.
OTP_DEMO_FALLBACK=true

# --- Frontend address(es) allowed to call the API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
